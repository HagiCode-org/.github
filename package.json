{
  "name": "sync-blog-rss",
  "version": "1.0.0",
  "description": "Sync blog RSS to README",
  "main": "sync-rss.ts",
  "type": "module",
  "scripts": {
    "sync": "tsx sync-rss.ts",
    "test": "tsx --test tests/*.test.ts",
    "test:rss-url:default": "tsx --test tests/sync-rss.test.ts",
    "test:rss-url:override": "HAGICODE_BLOG_RSS_URL_ZH=https://docs.hagicode.com/blog/rss.zh-CN.xml HAGICODE_BLOG_RSS_URL_EN=https://docs.hagicode.com/blog/rss.en-US.xml tsx --test tests/sync-rss.test.ts"
  },
  "dependencies": {
    "rss-parser": "^3.13.0"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "tsx": "^4.21.0",
    "typescript": "^5.3.0"
  }
}
